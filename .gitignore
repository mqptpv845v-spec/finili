# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Design & Work Files
*.zip
*.psd
*.ai
*.blend
*.indd
*.idml
*.pdf
*.xlsx
!samples/briefd-test-plan.xlsx
*.fig
*.sketch
*.numbers
*.eps
*.ttf
*.otf

# runtime output from the InDesign pipeline
/.tmp/
/public/output/

# generated billing documents can contain personal and financial data
/invoices/

# macOS resource forks
__MACOSX/
._*

# editors & local agent state
.vscode/
.claude/worktrees/

# specific.dev local overrides
specific.local

# specific.dev local runtime state
.specific/
